#!/bin/bash
# Updates the playlist from the terminal.
# Usage: trebletop-update <number_of_songs> <last_month|six_months|all_time>
DIR="$(dirname "$(readlink -f "$0")")/.."

if [ $# -ne 2 ] || ! [[ "$1" =~ ^[0-9]+$ ]] || [ $(( $1 % 50 )) -ne 0 ] || [ "$1" -eq 0 ]; then
	echo "Usage: trebletop-update <number_of_songs> <last_month|six_months|all_time>"
	echo "The number of songs must be a multiple of 50."
	exit 1
fi

case "$2" in
	last_month) RANGE=short_term ;;
	six_months) RANGE=medium_term ;;
	all_time)   RANGE=long_term ;;
	*) echo "Time period must be last_month, six_months or all_time."; exit 1 ;;
esac

cd "$DIR" && exec venv/bin/python spotify-script.py "$1" "$RANGE"
